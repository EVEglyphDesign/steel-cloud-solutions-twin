=\"font_0 wixui-rich-text__text\" style=\"font-size:56px; line-height:normal;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:56px;\" class=\"wixui-rich-text__text\">This is a title.</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5y4c66d6":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Unified Salesforce Interface:</span></span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Integrated JDEdwards data into Salesforce for seamless access to sales, customer, and order information.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Provided a user-friendly interface, improving data usability and accessibility.</span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Subsidiary-Specific Solutions:</span></span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Delivered tailored JDE integrations for unique subsidiary needs like warranties, commissions, and CPQ processes.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Enabled real-time data updates in Salesforce, simplifying tasks like warranty claims and order management.</span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Real-Time Data Access:</span></span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Facilitated a streamlined connection between JDEdwards and Salesforce, ensuring accurate and up-to-date information.</span></p>\n</li>\n</ul>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5y4c66d14":{"fillLayers":{"containerId":"comp-m5y4c66d14","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"columnOverrides":{"width":"100%","contentArea":{"alignment":0.5,"width":360}},"translations":{"ariaLabel":"content changes on hover"}},"comp-m5y4c66h":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-m5y4c66h","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"