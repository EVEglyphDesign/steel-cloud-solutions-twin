5px;\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-size:65px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\">The Problem</span></span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5yeqrap6":{"html":"<h2 class=\"font_0 wixui-rich-text__text\" style=\"font-size:56px; line-height:normal;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:56px;\" class=\"wixui-rich-text__text\">This is a title.</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5yeqraq":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Our client encountered key challenges in data management:</span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Lack of Access:</span></span> External users could not view data about their chapters, network members, or donations.</span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Manual Data Compilation: </span></span>Internal staff had to compile and send chapter reports annually using manual Salesforce formulas, which was time-intensive and inefficient.</span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Data Security Concerns: </span></span>Limited mechanisms to control data access led to privacy challenges.</span></p>\n</li>\n</ul>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5yeqraq10":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-m5yeqraq10","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-m5yeqrar3":{"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"fillLayers":{"containerId":"comp-m5yeqrar3","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false}},"comp-m5yeqrar10":{"fillLayers":{"containerId":"comp-m5yeqrar10","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"columnOverrides":{"width":"100%","contentArea":{"alignment":0.5,"width":360}},"translations":{"ariaLabel":"content changes on hover"}},"comp-m5yeqras6":{"fillLayers":{"containerId":"comp-m5yeqras6","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"image":{"hasAnimation":false,"alt":"pexels-yankrukov-8199165.jpg","width":6000,"height":4000,"uri":"6bf859_42a78bae11d5424aa8817ba3ee43cbb3~mv2.j