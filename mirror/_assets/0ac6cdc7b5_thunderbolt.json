=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:56px;\" class=\"wixui-rich-text__text\">This is a title.</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5y8xzur6":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Our Client grappled with the following challenges:</span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Fragmented operations</span></span> due to disjointed workflows across 40 brands.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Siloed data</span></span> that hindered collaboration and decision-making.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Brand-specific processes and commission structures, <span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">complicating unified oversight.</span></span></span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\">A lack of tools</span></span> to identify replicable successes and address inefficiencies across the organization.</span></p>\n</li>\n</ul>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5y8xzus5":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-m5y8xzus5","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-m5y8xzut":{"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"fillLayers":{"containerId":"comp-m5y8xzut","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false}},"comp-m5y8xzut7":{"fillLayers":{"containerId":"comp-m5y8xzut7","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"columnOverrides":{"width":"100%","contentArea":{"alignment":0.5,"width":360}},"translations":{"ariaLabel":"content changes on hover"}},"comp-m5y8xzuu6":{"fillLayers":{"containerId":"comp-m5y8xzuu6","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"image":{"hasAnimation":false,"alt":"Manufacturing AI 3.jpg","width":2500,"height":1410,"uri":"6bf859_7fe1bedfba7a4dc3a0fae5a2a5fa82bf~mv2.jpg","title":"Manufacturing AI 3.jpg","containerId":"comp-m5y8xzuu6","hasBgScrollEffect":"","bgEffectName":"","alignType":"center","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"containerWidth":620,"containerHeight":362},"shouldPadMedia":false,"hasCanvasAnimation":false},"meshProps":{"wedges":[],"rotatedComponents