---
import '../styles/global.css';
export interface Props { title: string; description?: string; active?: string; }
const { title, description = "Steel Cloud Solutions — Intelligent Automation Experts", active = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { label: "Home",          href: `${base}/`,              key: "home" },
  { label: "CPQ Migration", href: `${base}/cpq-migration`, key: "cpq"  },
  { label: "SAP Services",  href: `${base}/sap-services`,  key: "sap"  },
  { label: "About SCS",     href: `${base}/about`,         key: "about"},
  { label: "Blog",          href: `${base}/blog`,          key: "blog" },
  { label: "Contact",       href: `${base}/contact`,       key: "contact"},
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700&display=swap" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={`${base}/`}>
        <img src={`${base}/assets/logos/scs-mark.svg`} alt="SCS" onerror="this.style.display='none'" />
        <span>Steel Cloud Solutions</span>
      </a>
      <nav>
        {nav.map(item => (
          <a href={item.href} class={active === item.key ? 'active' : ''}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap row">
      <div>© {new Date().getFullYear()} Steel Cloud Solutions.</div>
      <div class="mute">
        <a href={`${base}/privacy`}>Privacy</a> · <a href={`${base}/terms`}>Terms</a>
      </div>
    </div>
  </footer>
</body>
</html>
