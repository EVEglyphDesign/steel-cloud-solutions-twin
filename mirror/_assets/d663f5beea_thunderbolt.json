e,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5yeqrav1":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Experience Cloud Platform:</span></span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Built a robust platform tailored to the client&#39;s unique needs.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Provided secure, regulated access for users, ensuring data privacy and relevancy.</span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\">User Permissions &amp; Real-Time Data Display:</span></span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Implemented granular access controls to allow users to view data specific to their chapters.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Developed dynamic dashboards with real-time data on members, donations, and performance metrics.</span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Automated Data Rollups:</span></span></span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Utilized Calculable Rollup Apex for efficient aggregation and real-time insights, ensuring accurate and actionable data was readily available.</span></p>\n</li>\n</ul>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5yeqrax1":{"fillLayers":{"containerId":"comp-m5yeqrax1","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"columnOverrides":{"width":"100%","contentArea":{"alignment":0.5,"width":360}},"translations":{"ariaLabel":"content changes on hover"}},"comp-m5yeqrb03":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-m5yeqrb03","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-m5yeqrb24":{"html":"<h2 class=\"font_0 wixui-rich-text__text\" style=\"font-size:56px; text-align:center;\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-size:56px;\" class=\"wixui-rich-text__text\">The Results</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCom