:"wysiwyg.viewer.components.WRichText"},"comp-m5wx1wap":{"html":"<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; letter-spacing:normal;\">\n<li style=\"line-height:1.8em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Our Client was facing frequent order entry errors</span></span>&nbsp;<span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">within their ERP system (JDEdwards), which led to <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\">lost</span></span></span></span><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\">&nbsp;<span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">revenue and wasted hours on manual corrections.</span></span></span></span></p>\n</li>\n<li style=\"line-height:1.8em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">The ongoing mistakes were causing <span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">frustration</span></span> across</span></span>&nbsp;<span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">their operations and <span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">slowing down their processes.</span></span></span></span></p>\n</li>\n<li style=\"line-height:1.8em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">They needed a proactive solution that would catch errors</span></span>&nbsp;<span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">before they spiraled into larger issues, <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\">ensuring accuracy</span></span></span></span><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\">&nbsp;</span></span><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"color:#E74D25;\" class=\"wixui-rich-text__text\">and efficiency</span></span> in real time.</span></span></p>\n</li>\n</ul>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m5wxghp9":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-m5wxghp9","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-m5wxghq31":{"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"fillLayers":{"containerId":"comp-m5wxghq31","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnim